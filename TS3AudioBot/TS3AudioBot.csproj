<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>TS3AudioBot</RootNamespace>
		<AssemblyName>TS3AudioBot</AssemblyName>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Version>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../version.txt').Trim())</Version>
        
        <ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<DebugType>embedded</DebugType>

		<ApplicationIcon>Assets\favicon.ico</ApplicationIcon>

		<NeutralLanguage>en</NeutralLanguage>

		<StartupObject>TS3AudioBot.Setup</StartupObject>

		<!-- GC Config -->
		<!-- Workstation GC: the bot is latency-bound, not throughput-bound. Server GC keeps one
		     heap per core (4 here) and holds far more memory for a process that idles near 0 %
		     CPU; its longer stop-the-world pauses are also exactly what an audio send thread
		     cannot afford. Concurrent GC keeps collections off the critical path. -->
		<ServerGarbageCollection>false</ServerGarbageCollection>
		<ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
		<!-- Release memory back to the OS instead of holding freed segments. -->
		<RetainVMGarbageCollection>false</RetainVMGarbageCollection>
		<!-- InvariantGlobalization stays off on purpose: it would make string.Normalize throw,
		     and the cover matcher relies on it to fold umlauts and compare non-latin titles. -->
		<!-- SourceLink -->
		<RepositoryUrl>https://github.com/Splamy/TS3AudioBot.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<!-- Assemblyinfo -->
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>

		<!-- Trimming-->
		<PublishTrimmed>false</PublishTrimmed>
		<TrimMode>partial</TrimMode>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CliWrap" Version="3.10.5" />
		<PackageReference Include="CommandLineParser" Version="2.9.1" />
		<PackageReference Include="NLog" Version="6.2.0" />
		<PackageReference Include="LiteDB" Version="5.0.21" />
		<PackageReference Include="Microsoft.AspNetCore.Cors" Version="2.3.12" />
		<PackageReference Include="Microsoft.AspNetCore.Server.Kestrel" Version="2.3.12" />
		<PackageReference Include="Microsoft.AspNetCore.StaticFiles" Version="2.3.12" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0">
			<ExcludeAssets>analyzers</ExcludeAssets>
		</PackageReference>
		<PackageReference Include="Nett" Version="0.15.0" />
		<PackageReference Include="PlaylistsNET" Version="1.4.1" />
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
		<PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.4" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Assets\*" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="lib\x64\libopus.dll">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<PackagePath>.</PackagePath>
			<Pack>true</Pack>
		</Content>
		<Content Include="lib\x86\libopus.dll">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<PackagePath>.</PackagePath>
			<Pack>true</Pack>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TSLib\TSLib.csproj" />
	</ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="TS3AudioBot.Tests" />
    </ItemGroup>
    
	<ItemGroup>
		<Compile Update="Localization\strings.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>strings.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Localization\strings.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>strings.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

</Project>
